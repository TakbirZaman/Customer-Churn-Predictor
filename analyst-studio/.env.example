# Copy to .env. Keep keys private. No paid model credentials are required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# Select a currently available tool-capable model in Google AI Studio.
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Set to the exact locally downloaded tool-capable model name to enable Ollama.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
PROVIDER_ORDER=groq,gemini,openrouter,ollama
ANALYST_HOME=.analyst

# Local churn prediction service (external hosts are intentionally rejected)
CHURN_API_URL=http://127.0.0.1:8000
